# ── Alpaca Trading API ────────────────────────────────────────────────────────
# Get free keys at https://alpaca.markets (paper trading needs no real money)
# Paper: https://app.alpaca.markets/paper-trading  |  Live: https://app.alpaca.markets/live-trading
ALPACA_KEY_ID=your_key_id_here
ALPACA_SECRET_KEY=your_secret_key_here
ALPACA_PAPER=true

# ── Optional market data providers ────────────────────────────────────────────
# Uncomment and fill in any of these to unlock additional data sources.
# All have free tiers — no credit card required.

# Alpha Vantage — stocks, forex, crypto  (500 calls/day free)
# Sign up: https://www.alphavantage.co/support/#api-key
# ALPHA_VANTAGE_KEY=your_key_here

# Finnhub — stocks, forex, crypto  (60 calls/min free)
# Sign up: https://finnhub.io
# FINNHUB_KEY=your_key_here

# Polygon.io — US stocks  (5 calls/min, previous-day data free)
# Sign up: https://polygon.io
# POLYGON_KEY=your_key_here
